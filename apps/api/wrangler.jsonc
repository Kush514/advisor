{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vm-one-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-03-20",
  // Only non-secret settings live here. Keys are Worker secrets (`wrangler secret put NAME`):
  //   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ADMIN_SYNC_SECRET, YOUTUBE_API_KEY, GEMINI_API_KEY,
  //   AMAZON_CREATORS_CLIENT_ID, AMAZON_CREATORS_CLIENT_SECRET, AMAZON_CREATORS_PARTNER_TAG, FRONTEND_URL
  // Locally they come from .dev.vars.
  "vars": {
    "YOUTUBE_SYNC_START_DATE": "2024-10-01"
  }
}
